# =====================================================================
#  Stash — the secrets this project uses, and where they live.
#  NEVER put real values in this repository (it is public).
#  This file only lists the names. The real values are set here:
# =====================================================================

# ---- Supabase → Edge Functions → Secrets (used by the quick-save function) ----
# A long random password the iPhone Shortcuts send in the "x-stash-key" header.
# At least 24 characters (README step 5b shows how to make a 64-character one).
STASH_QUICK_KEY=
# Your own user ID (Supabase → Authentication → Users → your email → User UID).
# Everything quick-save stores belongs to this user.
STASH_OWNER_USER_ID=

# Provided automatically by Supabase inside Edge Functions — do not add these yourself:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# ---- GitHub → repository Settings → Secrets and variables → Actions ----
# (used by .github/workflows/deploy-functions.yml to deploy the Edge Functions)
# A personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Your project's reference ID (the part before .supabase.co), e.g. imorekpkzucpjpplyabq
SUPABASE_PROJECT_REF=

# ---- Local development only (optional) ----
# The app's public Supabase URL + publishable key live in src/config.js (they are
# designed to be public; Row Level Security protects the data).
