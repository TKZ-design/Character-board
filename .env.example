# Stash — secrets, for reference only.
#
# The app itself needs no secrets. The "quick-save" Edge Function (one-tap
# saving from the iPhone Shortcut) needs the two below. They are NOT read from
# a file: you type them into the Supabase dashboard
#   Edge Functions → Secrets
# (README, step 6a). The values here are fake placeholders.
# Never put the real ones in this repository.

# A long random key that the "Save to Stash" Shortcut sends in the
# "x-stash-key" header. At least 20 characters; 40 or more is better.
QUICK_SAVE_KEY=replace-with-a-long-random-key-of-40-or-more-characters

# Your own user ID (Supabase → Authentication → Users → UID column).
# Quick Save can only ever add links to this account.
OWNER_USER_ID=00000000-0000-0000-0000-000000000000
